{
  "name": "hanamask",
  "version": "2.1.1",
  "license": "Apache-2.0",
  "private": true,
  "description": "AI開発に最適化されたMCPネイティブ・ローカルノートアプリ（Electron。タスク管理は補助機能として同梱。仕様: docs/REQUIREMENTS.md）",
  "author": "Tanar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanar-tech/hanamask.git"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && node scripts/copy-main-assets.mjs",
    "build:site": "vite build --config site/vite.config.ts",
    "lint": "eslint .",
    "fetch:model": "node scripts/fetch-embedding-model.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:readme": "node scripts/check-readme-tools.mjs",
    "check:tasks": "node scripts/check-task-status.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "package:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "mermaid": "^11.16.1",
    "motion": "^12.43.0",
    "node-llama-cpp": "^3.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  }
}
