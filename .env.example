# DBはPostgreSQL想定（docs/REQUIREMENTS.md §5）。ローカルはDocker等で用意する。
# 本番はAurora Serverless v2（接続文字列はSecrets Manager管理。docs/AWS.md）。
DATABASE_URL="postgresql://user:password@localhost:5432/work_manager"

# セッショントークン署名用シークレット（docs/REQUIREMENTS.md §4.6、src/server/token.ts）
# openssl rand -base64 32 などで生成する。旧NEXTAUTH_SECRETも互換のため読み込まれる。
AUTH_SECRET="openssl rand -base64 32 などで生成する"

# ローカルAPIサーバーのポート（省略時 3001。next devが /api/* をここへプロキシする）
# API_PORT="3001"

# Stripe（docs/REQUIREMENTS.md §4.8）。カード情報は自社で保持しない。
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
