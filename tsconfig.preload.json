{
  "extends": "./tsconfig.main.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    // 出力先をmainと分ける。同じdistへ吐くと、preload(CommonJS)のコンパイル結果が
    // 共有ファイル(src/shared)をmain(ESM)の出力に上書きし、mainの起動が壊れる。
    // dist の外に置くのは、中間生成物がインストーラーに同梱されないようにするため
    // （electron-builder.yml が dist/** を丸ごと同梱する）。
    "outDir": ".preload-build"
  },
  "include": ["src/preload/**/*.ts"]
}
