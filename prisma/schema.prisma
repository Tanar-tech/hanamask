// hanamask データモデル（未確定。アプリ仕様の決定後にモデルを追加する）。

generator client {
  provider = "prisma-client-js"
  // native: ローカル開発（Windows/Mac/Linux）用
  // rhel-openssl-3.0.x: AWS Lambda (Node.js 24, Amazon Linux 2023) 用（docs/AWS.md）
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
