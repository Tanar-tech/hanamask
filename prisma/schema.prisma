// work-manager データモデル（docs/REQUIREMENTS.md §6 準拠）
// 未確定事項（プラン体系の詳細等）は docs/REQUIREMENTS.md §7 を参照。

generator client {
  provider = "prisma-client-js"
  // native: ローカル開発（Windows/Mac/Linux）用
  // rhel-openssl-3.0.x: AWS Lambda (Node.js 24, Amazon Linux 2023) 用（docs/AWS.md）
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

enum Plan {
  free
  pro
}

enum TaskType {
  work
  break
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  memberships  Membership[]
  tasks        Task[]
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Organization {
  id               String        @id @default(cuid())
  name             String
  plan             Plan          @default(free)
  stripeCustomerId String?       @unique
  memberships      Membership[]
  projects         Project[]
  tasks            Task[]
  subscription     Subscription?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  role           Role         @default(member)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model Project {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  color          String       @default("#6366f1")
  isArchived     Boolean      @default(false)
  tasks          Task[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Task {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  // プロジェクト削除時、タスク記録自体は残しプロジェクト紐付けのみ外す（グループ管理機能、/goal指示）。
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId      String?
  name           String
  type           TaskType     @default(work)
  startTime      DateTime
  endTime        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId, startTime])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // 生トークンはメール送信時のみ扱い、DBにはハッシュ値のみ保存する（漏洩時に無効化できないリスクを避けるため）。
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Subscription {
  id                   String       @id @default(cuid())
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId       String       @unique
  stripeSubscriptionId String       @unique
  status               String
  currentPeriodEnd     DateTime
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}
